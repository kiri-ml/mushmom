{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "strict": true,
    "noImplicitAny": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "noEmitOnError": true,
    "removeComments": false,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "functions/**/*.ts",
    "tests/**/*.ts",
    "workers/**/*.ts"
  ]
}
