{
  "name": "mushmom",
  "version": "0.2.0",
  "private": true,
  "description": "MapleLegends population statistics dashboard for Cloudflare Pages.",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "npm run test && npm run typecheck && npm run build",
    "generate:stats-archive": "node scripts/generate_stats_archive.cjs",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name mushmom"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  }
}
