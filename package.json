{
  "name": "mushmom",
  "version": "0.3.0",
  "private": true,
  "description": "MapleLegends population statistics dashboard for Cloudflare Pages.",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "npm run test && npm run typecheck && npm run build",
    "generate:stats-archive": "node scripts/generate_stats_archive.cjs",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name mushmom"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "lucide": "^1.26.0"
  }
}
